datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }
model PriceList { id String @id @default(uuid()) areaType String @map("area_type") name String vendor String? @default("") description String? @default("") unit String @default("sq ft") quantity Float @default(1) price Float @default(0) createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@index([name]) @@index([vendor]) @@map("price_list") }
model RecentItem { id String @id @default(uuid()) areaType String? @map("area_type") name String vendor String? @default("") description String? @default("") unit String @default("Nos.") quantity Float @default(1) price Float @default(0) createdAt DateTime @default(now()) @map("created_at") @@index([name]) @@map("recent_items") }
model Quote { id String @id @default(uuid()) invoiceNo String @unique @map("invoice_no") client String phone String? projectType String? @map("project_type") location String? area Float? @default(0) validity String? @default("15 days") terms String? totals Json items Json createdAt DateTime @default(now()) @map("created_at") updatedAt DateTime @updatedAt @map("updated_at") @@index([createdAt]) @@map("quotes") }
